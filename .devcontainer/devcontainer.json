{
	"name": "Python 3 & Containerlab",
	"dockerComposeFile": "docker-compose.yml",
	"service": "multiflora",
	"runServices": ["multiflora","containerlab"],
  	"workspaceFolder": "${localWorkspaceFolder}",
	"remoteUser": "multiflora",
	"containerEnv": {
    	//#"PYTHONUNBUFFERED": "1",
    	"DISPLAY": "${localEnv:DISPLAY}"
  	},

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"srl-labs.vscode-containerlab"
			]
		}
	}
}